[Unit]
Description=ResMan - Dynamic CPU/RAM/IO Resource Management
Documentation=https://github.com/fdefilippo/resman
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target systemd-user-sessions.service vcs.service shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/usr/bin/resman /etc/resman.conf /sys/fs/cgroup /var/log /run
ConditionDirectoryNotEmpty=/sys/fs/cgroup

[Service]
Type=simple
User=root
RuntimeDirectory=resman
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
# ResMan discovers and enables the controllers required by the active features.
# Keeping controller setup in the daemon preserves its mandatory/optional
# diagnostics and lets CPU quota enforcement run without cpuset.
ExecStart=/usr/bin/resman --config /etc/resman.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# CPU priority (-20 is the highest, 19 is the lowest)
Nice=-10

# Resource limits
LimitNOFILE=65536
LimitNPROC=65536

# Hardening
#NoNewPrivileges=true
#PrivateTmp=true
#ProtectSystem=strict
#ProtectHome=true
#ProtectKernelTunables=true
#ProtectKernelModules=true
#ProtectControlGroups=true
#RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
#RestrictNamespaces=true
#RestrictRealtime=true
#MemoryDenyWriteExecute=true
#LockPersonality=true

# Cgroups
#CPUAccounting=true
#MemoryAccounting=true

# Writable directories
ReadWritePaths=/sys/fs/cgroup
ReadWritePaths=/var/log
ReadWritePaths=/var/run
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
