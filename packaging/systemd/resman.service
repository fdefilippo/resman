[Unit]
Description=ResMan - Dynamic CPU/RAM/IO Resource Management
Documentation=https://github.com/fdefilippo/resman
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target systemd-user-sessions.service vcs.service shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/usr/bin/resman /etc/resman/resman.conf /etc/resman/cpu-points.map /var/lib/resman /sys/fs/cgroup /var/log /run
ConditionDirectoryNotEmpty=/sys/fs/cgroup
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=root
# ResMan discovers and enables the controllers required by the active features.
# Keeping controller setup in the daemon preserves its mandatory/optional
# diagnostics and lets CPU quota enforcement run without cpuset.
ExecStart=/usr/bin/resman --config /etc/resman/resman.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
# Keep the service manager's outer deadline above the default daemon deadline.
# Override both values together when a deployment needs more shutdown time.
TimeoutStopSec=75s
StandardOutput=journal
StandardError=journal
# CPU priority (-20 is the highest, 19 is the lowest)
Nice=-10

# Resource limits
LimitNOFILE=65536
LimitNPROC=65536

# Privilege surface. ResMan must run as root because systemd authorizes unit
# property mutation on the system bus by uid through polkit, not through a
# Linux capability. The bounding set is therefore the boundary, and it holds
# only what the enabled features actually use:
#   CAP_SYS_PTRACE        readlink /proc/PID/exe and read /proc/PID/io and
#                         /proc/PID/smaps_rollup for processes of other users
#   CAP_DAC_READ_SEARCH   read those mode-0400 entries it does not own
#   CAP_SETUID CAP_SETGID run the limit hook under its non-root NSS identity
#   CAP_KILL              signal the hook process group after it dropped privilege
#   CAP_NET_BIND_SERVICE  PROMETHEUS_METRICS_BIND_PORT and MCP_HTTP_PORT accept
#                         a minimum of 1, so a privileged port is supported
#   CAP_SYS_RESOURCE      register PSI poll triggers on cgroup pressure files
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL CAP_NET_BIND_SERVICE CAP_SYS_RESOURCE

# /usr, the boot directories and /etc are read-only. /var and /run stay
# writable so LOG_FILE, the metrics database and the systemd property lease
# journal keep working wherever the operator points them. The only write target
# below /etc is the configuration directory, used by the MCP configuration
# editor and the CPU Points map editor.
ProtectSystem=full
ReadWritePaths=/etc/resman
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
