[Unit]
Description=ResMan - Dynamic CPU/RAM/IO Resource Management
Documentation=https://github.com/fdefilippo/resman
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target systemd-user-sessions.service vcs.service shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/usr/bin/resman /etc/resman.conf /sys/fs/cgroup /var/log /run
ConditionDirectoryNotEmpty=/sys/fs/cgroup

[Service]
Type=simple
User=root
RuntimeDirectory=resman
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
ExecStartPre=/bin/sh -ec 'echo "+cpu" > /sys/fs/cgroup/cgroup.subtree_control; echo "+cpuset" > /sys/fs/cgroup/cgroup.subtree_control'
ExecStartPre=-/bin/sh -c 'echo "+io" > /sys/fs/cgroup/cgroup.subtree_control'
ExecStartPre=-/bin/sh -c 'echo "+memory" > /sys/fs/cgroup/cgroup.subtree_control'
ExecStart=/usr/bin/resman --config /etc/resman.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# Priorità CPU (da -20 a 19, dove -20 è la più alta)
Nice=-10

# Limiti di sicurezza
LimitNOFILE=65536
LimitNPROC=65536

# Hardening
#NoNewPrivileges=true
#PrivateTmp=true
#ProtectSystem=strict
#ProtectHome=true
#ProtectKernelTunables=true
#ProtectKernelModules=true
#ProtectControlGroups=true
#RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
#RestrictNamespaces=true
#RestrictRealtime=true
#MemoryDenyWriteExecute=true
#LockPersonality=true

# Cgroups
#Delegate=cpu cpuset
#CPUAccounting=true
#MemoryAccounting=true

# Permessi di directory
ReadWritePaths=/sys/fs/cgroup
ReadWritePaths=/var/log
ReadWritePaths=/var/run
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
