FROM docker.io/library/golang:1.25.7-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY main.go ./
COPY cgroup ./cgroup
COPY config ./config
COPY database ./database
COPY internal ./internal
COPY logging ./logging
COPY mcp ./mcp
COPY metrics ./metrics
COPY reloader ./reloader
COPY state ./state
COPY test/functional/smolvm/guest/workload.go ./test/functional/smolvm/guest/workload.go
RUN CGO_ENABLED=1 go build -trimpath \
    -ldflags="-s -w -X 'main.version=functional'" \
    -o /out/resman ./main.go \
 && CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w" \
    -o /out/resman-functional-workload ./test/functional/smolvm/guest/workload.go

FROM docker.io/amd64/oraclelinux:9

ENV container=smolvm

RUN dnf install -y ca-certificates curl procps-ng shadow-utils sqlite systemd util-linux \
 && dnf clean all \
 && rm -rf /var/cache/dnf \
 && useradd --create-home --shell /bin/bash resman-cpu \
 && useradd --create-home --shell /bin/bash resman-memory \
 && useradd --create-home --shell /bin/bash resman-io

COPY --from=builder /out/resman /usr/bin/resman
COPY --from=builder /out/resman-functional-workload /usr/bin/resman-functional-workload
COPY test/functional/smolvm/guest/resman-functional@.service \
     /usr/lib/systemd/system/resman-functional@.service
COPY test/functional/smolvm/guest/run-functional.sh \
     test/functional/smolvm/guest/wait-systemd.sh \
     test/functional/smolvm/guest/workload.sh \
     /opt/resman-functional/
COPY test/functional/smolvm/fixtures/resman.conf \
     /opt/resman-functional/fixtures/resman.conf

RUN chmod 0755 /usr/bin/resman /usr/bin/resman-functional-workload \
      /opt/resman-functional/run-functional.sh \
      /opt/resman-functional/wait-systemd.sh \
      /opt/resman-functional/workload.sh \
 && systemctl mask systemd-networkd-wait-online.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
