{
  "annotations": {
    "list": []
  },
  "description": "ResMan v2.1 - SysAdmin Operations Dashboard. Shows system health, top consumers, limit effectiveness, CPU trends (instant/avg/EMA), IO throughput, and capacity planning. Designed for operational use.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Current Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": null,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "CPU Usage",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": null,
      "datasource": "${prometheus_datasource}",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80.0
              },
              {
                "color": "red",
                "value": 90.0
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "resman_cpu_total_usage_percent{cluster=~\"$cluster\", server_role=~\"$server_role\", hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
